{
  "name": "@forge-editor/plugin",
  "version": "0.1.3",
  "description": "Write Forge plugins in JavaScript or TypeScript",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./process": { "types": "./process.d.ts", "default": "./process.js" }
  },
  "types": "index.d.ts",
  "bin": {
    "forge-plugin": "bin/forge-plugin.js"
  },
  "files": ["index.js", "index.d.ts", "process.js", "process.d.ts", "types", "bin", "wit"],
  "scripts": {
    "types": "jco guest-types wit --world-name plugin-with-processes -o types"
  },
  "forgeWit": "0.1.30",
  "dependencies": {
    "@bytecodealliance/componentize-js": "^0.23.0",
    "@bytecodealliance/preview2-shim": "^0.26.0",
    "esbuild": "^0.28.0"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.35.0"
  },
  "license": "MIT"
}
